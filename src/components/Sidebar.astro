---
import { SITE_TITLE } from '../consts';
import { getAllPosts } from '../lib/posts';

const posts = await getAllPosts();
const pathname = Astro.url.pathname;
---

<aside>
	<a class="site-title" href="/" aria-current={pathname === '/' ? 'page' : undefined}>{SITE_TITLE}</a>
	<nav aria-label="Posts">
		<ul>
			{
				posts.map((post) => (
					<li>
						<a href={post.href} aria-current={pathname === post.href ? 'page' : undefined}>
							{post.data.title}
						</a>
						{post.draft && <span class="draft">draft</span>}
					</li>
				))
			}
		</ul>
	</nav>
</aside>
<style>
	aside {
		font-family: var(--font-heading);
		font-size: 0.9rem;
		line-height: 1.5;
	}
	.site-title {
		display: block;
		margin-bottom: 1.5rem;
		font-weight: 700;
		color: var(--fg);
		text-decoration: none;
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		margin: 0 0 0.6rem 0;
	}
	a {
		color: var(--muted);
		text-decoration: none;
	}
	a:hover,
	a[aria-current='page'] {
		color: var(--fg);
	}
	nav a[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.draft {
		margin-left: 0.4em;
		padding: 0 0.35em;
		border: 1px solid var(--muted);
		border-radius: 3px;
		font-size: 0.7em;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		vertical-align: middle;
	}
</style>
