---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Site from './Site.astro';

type Props = CollectionEntry<'blog'>['data'] & { draft?: boolean };

const { title, description, pubDate, updatedDate, draft = false } = Astro.props;
---

<Site title={title} description={description}>
	<article>
		<header>
			{draft && <p class="draft">Draft · not published</p>}
			<h1>{title}</h1>
			<p class="date">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span class="updated">
							· updated <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
		</header>
		<div class="prose">
			<slot />
		</div>
	</article>
</Site>
<style>
	header {
		margin-bottom: 2rem;
	}
	h1 {
		margin-bottom: 1rem;
	}
	.date {
		font-family: var(--font-heading);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin: 0;
		color: var(--muted);
		font-size: 0.75rem;
	}
	.draft {
		font-family: var(--font-heading);
		display: inline-block;
		margin: 0 0 0.75rem 0;
		padding: 0.1em 0.5em;
		border: 1px solid var(--muted);
		border-radius: 3px;
		font-size: 0.75rem;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
</style>
